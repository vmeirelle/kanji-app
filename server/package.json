{
  "name": "kanji-app-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "migrate": "npx typeorm-ts-node-commonjs migration:run -d src/Main/container/database.ts",
    "migrate:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/Main/container/database.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "mysql2": "^3.12.0",
    "path-to-regexp": "^6.3.0",
    "qs": "^6.13.1",
    "reflect-metadata": "^0.2.2",
    "ts-results": "^3.3.0",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/md5": "^2.3.5",
    "@types/node": "^20.19.0",
    "@types/qs": "^6.9.17",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}

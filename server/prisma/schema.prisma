generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  rankings     Ranking[]

  @@map("users")
}

model Ranking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String
  correct   Int
  total     Int
  points    Int
  day       String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([day, points])
  @@index([userId])
  @@map("rankings")
}
